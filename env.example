# 复制此文件为 .env 并填入真实值
# cp env.example .env

# Anthropic API
ANTHROPIC_AUTH_TOKEN=your_api_key_here
ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
ANTHROPIC_MODEL=mimo-v2-pro

# 飞书 webhook
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_hook_id

# 交易安全开关（默认禁止真实执行）
TRADING_ENABLED=false
PAPER_TRADING_ONLY=true

# 新 Runtime 需显式启用，默认保留旧入口
AI_TRADER_RUNTIME_MODE=legacy
# 调度器可选 pipeline / agent / production，默认 pipeline
AI_TRADER_AGENT_MODE=pipeline
RUNTIME_DATABASE_URL=sqlite:///data/agent_runtime.db
